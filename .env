# =========================================================================
# VERCEL DEPLOYMENT CONFIGURATION
# Copy these values into your Vercel Project Settings -> Environment Variables
# =========================================================================

# 1. MongoDB (Must be MongoDB Atlas URI for Vercel, localhost won't work)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=foodcourt

# 2. Security (Change to a random string in production)
JWT_SECRET_KEY=foodcourt_super_secret_key_2024_change_in_production

# 3. Google Authentication
GOOGLE_CLIENT_ID=77957118883-n0f61t165nj05m29q01k953rb3q7afun.apps.googleusercontent.com.apps.googleusercontent.com

# 4. Admin Credentials
ADMIN_EMAIL=admin@foodcourt.com
ADMIN_PASSWORD=admin123

# 5. App Settings
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=16777216
